#!/bin/sh
set -eu

if ! command -v jj >/dev/null 2>&1; then
  exit 0
fi

repository_root="{{ .chezmoi.workingTree }}"
if [ -d "$repository_root/.git" ] && [ ! -d "$repository_root/.jj" ]; then
  jj git init --colocate "$repository_root"
fi

# Keep the identity out of the chezmoi-managed config.toml so applies preserve it.
identity_file="{{ .chezmoi.homeDir }}/.config/jj/conf.d/identity.toml"

configure_identity() {
  key="$1"

  # jj defaults user.name and user.email to empty strings.
  if [ -n "$(jj config get "$key" 2>/dev/null || true)" ]; then
    return 0
  fi

  value="$(git config --global --get "$key" 2>/dev/null || true)"
  if [ -n "$value" ]; then
    mkdir -p "$(dirname "$identity_file")"
    JJ_CONFIG="$identity_file" jj config set --user "$key" "$value"
  fi
}

configure_identity user.name
configure_identity user.email
