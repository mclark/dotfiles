{{- if eq .chezmoi.os "darwin" -}}
#!/bin/sh
set -eu

# Configure macOS keyboard settings for fast repeat rate
# This is user-specific and won't affect other users on this Mac

defaults write NSGlobalDomain InitialKeyRepeat -int 15
defaults write NSGlobalDomain KeyRepeat -int 2
{{- else -}}
#!/bin/sh
exit 0
{{- end }}
